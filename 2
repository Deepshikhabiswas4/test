Path uploadRoot = Paths.get("/media/CRS/TAR/Upload").toAbsolutePath().normalize();
Path checkDirPath = Paths.get(getSafePath(checkIsExist)).toAbsolutePath().normalize();
if (!checkDirPath.startsWith(uploadRoot)) {
    throw new SecurityException("Invalid directory path");
}
if (!Files.exists(checkDirPath)) {
    Files.createDirectories(checkDirPath);
}


