    public byte[] reportFromServer(int submissionId, boolean flag) throws IOException {
        if (submissionId <= 0) {
            throw new IllegalArgumentException("Invalid submission ID");
        }

        String reportId = String.valueOf(submissionId);

        ArrayList<TarReportsMasterList> getBranchReportPath = null;
        ArrayList<TarArchive> getBranchReportPathArchive = null;

        if (flag) {
            getBranchReportPath = tarReportsMasterListRepository.getBranchReportPath(submissionId);
        } else {
            getBranchReportPathArchive = tarMainArchiveRepository.getBranchReportPathArchive(reportId);
        }

        String fullPath = null;
        if (flag && getBranchReportPath != null && !getBranchReportPath.isEmpty()) {
            fullPath = getBranchReportPath.get(0).getPdfFilePath();
        } else if (!flag && getBranchReportPathArchive != null && !getBranchReportPathArchive.isEmpty()) {
            fullPath = getBranchReportPathArchive.get(0).getPdfFilePath();
        }

        if (fullPath == null || fullPath.trim().isEmpty() || !fullPath.contains("/")) {
            throw new SecurityException("Unauthorized or invalid report access");
        }

        String rawFileName = fullPath.substring(fullPath.lastIndexOf('/') + 1);
        String safeFileName = new File(rawFileName).getName();
        String filePath = fullPath.substring(0, fullPath.lastIndexOf('/'));

        log.info("Processing file: {}", sanitizeLog(safeFileName));

        byte[] pdfFile = null;
        String serverPostKeyString = "0";
        String serverIp = CommonServerFunctions.getServerIp(serverPostKeyString);
        String encryptedSftpPass = crsPropertyRepository.getServerPwd(serverIp);

        log.info("Connecting to SFTP server: {}", sanitizeLog(serverIp));

        boolean fileTransfer = FileTransfer.getFileFromSftp(safeFileName, serverPostKeyString, filePath);
        log.info("File transfer status: {}", fileTransfer);

        if (fileTransfer) {
            File baseDir = new File(".").getCanonicalFile();
            File file2 = new File(baseDir, safeFileName).getCanonicalFile();

            if (!file2.getPath().startsWith(baseDir.getPath())) {
                throw new SecurityException("Invalid file path");
            }

            pdfFile = FileUtils.readFileToByteArray(file2);
        }

        return pdfFile;
    }

    private String sanitizeLog(String input) {
        if (input == null) {
            return "";
        }
        return input.replaceAll("[\r\n]", "_");
    }
    
