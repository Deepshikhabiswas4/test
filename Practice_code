    log_etl(
        spark,
        process_run_id,
        "accrued_int",
        1,
        f"ETL date identified: {date_str}"
    )

    date_obj = datetime.strptime(
        date_var,
        "%d-%m-%Y"
    )

    output_date = date_obj.strftime(
        "%d-%b-%y"
    ).upper()

    log_etl(
        spark,
        process_run_id,
        "accrued_int",
        1,
        f"Oracle balance date prepared: {output_date}"
    )

    # ======================================================
    # INPUT / OUTPUT PATH
    # ======================================================

    path = (
        f"{hdfs}/CBS-FILES/{date_var}/misc/CON*"
    )

    output_path = (
        f"{hdfs}/reports/{date_str}/"
        f"CONSOLIDATED-DEPOSITS-FILES/"
    )

    log_etl(
        spark,
        process_run_id,
        "accrued_int",
        1,
        f"Input path identified: {path}"
    )

    log_etl(
        spark,
        process_run_id,
        "accrued_int",
        1,
        f"Output path identified: {output_path}"
    )

    # ======================================================
    # READ RAW FILE
    # ======================================================

    raw_df = (
        spark.read
        .option("header", "false")
        .csv(path)
        .toDF("glcc", "amount")
    )

    raw_count = raw_df.count()

    log_etl(
        spark,
        process_run_id,
        "accrued_int",
        1,
        f"Consolidated deposits file read successfully. "
        f"Records read: {raw_count}"
    )

    # ======================================================
    # PARSE DATA
    # ======================================================

    parsed_df = (
        raw_df
        .withColumn(
            "branch_code",
            F.substring(
                F.col("glcc"),
                1,
                5
            )
        )
        .withColumn(
            "currency_code",
            F.substring(
                F.col("glcc"),
                6,
                3
            )
        )
        .withColumn(
            "cgl",
            F.substring(
                F.col("glcc"),
                9,
                10
            )
        )
        .withColumn(
            "segment_code",
            F.substring(
                F.col("glcc"),
                13,
                4
            )
        )
        .withColumn(
            "amount",
            F.col("amount").cast(
                "decimal(18, 4)"
            )
        )
    )

    parsed_count = parsed_df.count()

    log_etl(
        spark,
        process_run_id,
        "accrued_int",
        1,
        f"Consolidated deposits data parsed successfully. "
        f"Records parsed: {parsed_count}"
    )

    # ======================================================
    # READ BRANCH MASTER
    # ======================================================

    branch_master = read_oracle(
        spark,
        "SELECT CODE AS BRANCH_CODE FROM BRANCH_MASTER"
    )

    log_etl(
        spark,
        process_run_id,
        "accrued_int",
        1,
        "BRANCH_MASTER read successfully"
    )

    # ======================================================
    # READ CGL MASTER
    # ======================================================

    cgl_master = read_oracle(
        spark,
        "SELECT CGL_NUMBER AS cgl FROM CGL_MASTER"
    )

    log_etl(
        spark,
        process_run_id,
        "accrued_int",
        1,
        "CGL_MASTER read successfully"
    )

    # ======================================================
    # READ CURRENCY MASTER
    # ======================================================

    currency_master = read_oracle(
        spark,
        "SELECT CURRENCY_CODE, CURRENCY_RATE "
        "FROM CURRENCY_MASTER"
    )

    log_etl(
        spark,
        process_run_id,
        "accrued_int",
        1,
        "CURRENCY_MASTER read successfully"
    )

    # ======================================================
    # VALIDATION
    # ======================================================

    validated_df = (
        parsed_df
        .join(
            F.broadcast(branch_master),
            on="branch_code",
            how="inner"
        )
        .join(
            F.broadcast(cgl_master),
            on="cgl",
            how="inner"
        )
        .join(
            F.broadcast(currency_master),
            on="currency_code",
            how="left"
        )
    )

    validated_count = validated_df.count()

    log_etl(
        spark,
        process_run_id,
        "accrued_int",
        1,
        f"Data validation completed successfully. "
        f"Validated records: {validated_count}"
    )

    # ======================================================
    # CALCULATE FINAL AMOUNT
    # ======================================================

    result_df = (
        validated_df
        .withColumn(
            "effective_rate",
            F.when(
                F.col("currency_code") == "INR",
                F.lit(1.0)
            ).otherwise(
                F.coalesce(
                    F.col("currency_rate"),
                    F.lit(1.0)
                )
            )
        )
        .withColumn(
            "final_amount",
            F.round(
                F.col("amount") *
                F.col("effective_rate"),
                2
            )
        )
    )

    result_df = result_df.cache()

    result_count = result_df.count()

    log_etl(
        spark,
        process_run_id,
        "accrued_int",
        1,
        f"Final amount calculation completed. "
        f"Result records: {result_count}"
    )

    # ======================================================
    # READ ACCR_INT_HEADS
    # ======================================================

    accr_int_heads = read_oracle(
        spark,
        "SELECT HEAD_CODE, FLAG FROM ACCR_INT_HEADS"
    )

    log_etl(
        spark,
        process_run_id,
        "accrued_int",
        1,
        "ACCR_INT_HEADS read successfully"
    )

    # ======================================================
    # READ RB_PARSED_TEMPLATE
    # ======================================================

    rb_parsed_table = read_oracle(
        spark,
        "SELECT HEAD_CODE, HEAD_DESC, CGL AS cgl "
        "FROM RB_PARSED_TEMPLATE"
    )

    log_etl(
        spark,
        process_run_id,
        "accrued_int",
        1,
        "RB_PARSED_TEMPLATE read successfully"
    )

    # ======================================================
    # READ GL BALANCE
    # ======================================================

    gl_balance_table = read_oracle(
        spark,
        f"SELECT CGL, INR_BALANCE "
        f"FROM GL_BALANCE "
        f"WHERE BALANCE_DATE = '{output_date}' "
        f"AND CGL LIKE '5%'"
    )

    log_etl(
        spark,
        process_run_id,
        "accrued_int",
        1,
        f"GL_BALANCE read successfully for balance date "
        f"{output_date}"
    )

    # ======================================================
    # CREATE HEAD-CGL MAP
    # ======================================================

    head_cgl_map = (
        F.broadcast(accr_int_heads)
        .join(
            rb_parsed_table,
            on="HEAD_CODE",
            how="inner"
        )
    )

    head_cgl_map = head_cgl_map.cache()

    head_map_count = head_cgl_map.count()

    log_etl(
        spark,
        process_run_id,
        "accrued_int",
        1,
        f"HEAD-CGL mapping created successfully. "
        f"Mapping records: {head_map_count}"
    )

    # ======================================================
    # HEAD DATAFRAME
    # ======================================================

    head_df = (
        head_cgl_map
        .select(
            "HEAD_CODE",
            "FLAG",
            "HEAD_DESC"
        )
        .distinct()
    )

    head_df = head_df.cache()

    head_count = head_df.count()

    log_etl(
        spark,
        process_run_id,
        "accrued_int",
        1,
        f"Head dataframe created successfully. "
        f"Distinct heads: {head_count}"
    )

    # ======================================================
    # FILE BALANCE
    # ======================================================

    file_balance_df = (
        head_cgl_map
        .join(
            result_df,
            on="cgl",
            how="inner"
        )
        .groupBy("HEAD_CODE")
        .agg(
            F.sum("final_amount").alias(
                "file_balance"
            )
        )
    )

    file_balance_count = file_balance_df.count()

    log_etl(
        spark,
        process_run_id,
        "accrued_int",
        1,
        f"File balance calculated successfully. "
        f"Head records: {file_balance_count}"
    )

    # ======================================================
    # GL MEMO BALANCE
    # ======================================================

    gl_memo_df = (
        head_cgl_map
        .join(
            gl_balance_table,
            on="cgl",
            how="inner"
        )
        .groupBy("HEAD_CODE")
        .agg(
            F.sum("INR_BALANCE").alias(
                "memo_balance"
            )
        )
    )

    gl_memo_count = gl_memo_df.count()

    log_etl(
        spark,
        process_run_id,
        "accrued_int",
        1,
        f"GL memo balance calculated successfully. "
        f"Head records: {gl_memo_count}"
    )

    # ======================================================
    # FINAL SUMMARY
    # ======================================================

    final_summary_df = (
        head_df
        .join(
            file_balance_df,
            on="HEAD_CODE",
            how="left"
        )
        .join(
            gl_memo_df,
            on="HEAD_CODE",
            how="left"
        )
        .withColumn(
            "file_balance",
            F.coalesce(
                F.col("file_balance"),
                F.lit(0.0)
            )
        )
        .withColumn(
            "memo_balance",
            F.coalesce(
                F.col("memo_balance"),
                F.lit(0.0)
            )
        )
        .withColumn(
            "total_balance",
            F.when(
                F.col("FLAG") == "Y",
                F.col("file_balance")
                - F.col("memo_balance")
            ).otherwise(
                F.col("file_balance")
            )
        )
        .filter(
            F.col("total_balance") != 0
        )
    )

    final_summary_count = final_summary_df.count()

