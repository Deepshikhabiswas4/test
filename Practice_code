# ==========================================================
# HDFS
# ==========================================================
java_import(spark._jvm, "org.apache.hadoop.fs.FileSystem")
java_import(spark._jvm, "org.apache.hadoop.fs.Path")

fs = spark._jvm.FileSystem.get(
    spark._jsc.hadoopConfiguration()
)

# ==========================================================
# INPUT FOLDER
# ==========================================================
# CBS-FILES is the base folder containing all date folders.
# read_patterns() will find all required BGL paths between
# from_date and to_date.
# ==========================================================

input_folder = f"{HDFS_BASE}/CBS-FILES"

allpaths = []
allpaths.append(input_folder)

print("====================================================")
print(f"Input Base Folder : {input_folder}")
print(f"From Date         : {from_date}")
print(f"To Date           : {to_date}")
print("====================================================")

found, unfound = read_patterns(
    spark,
    allpaths
)

print("====================================================")
print(f"Found paths       : {len(found)}")
print(f"Unfound paths     : {len(unfound)}")
print("====================================================")

print("Found paths:")
for f in found:
    print(f)

# ==========================================================
# PROCESS ALL FOUND PATHS
# ==========================================================

for f in found:

    file_name = None

    try:

        print("====================================================")
        print(f"Processing path : {f}")
        print("====================================================")

        # ==================================================
        # READ CURRENT FOUND PATH
        # ==================================================

        file_df = (
            spark.read
            .format("text")
            .load(f)
            .withColumn(
                "FILE_NAME",
                regexp_replace(
                    substring_index(
                        input_file_name(),
                        "/",
                        -1
                    ),
                    r"\.txt.gz$",
                    ""
                )
            )
        )

        # ==================================================
        # GET ACTUAL FILE NAME
        # ==================================================

        file_name = (
            file_df
            .select("FILE_NAME")
            .first()["FILE_NAME"]
        )

        print(f"File Name : {file_name}")

        file_df.show(20, False)

        # ==================================================
        # PARSE FILE
        # ==================================================

        parts = split(col("value"), r"\|")

        parsed_df = file_df.select(

            concat(
                substring(
                    parts.getItem(0),
                    8,
                    7
                ),
                parts.getItem(1)
            ).alias("ACCOUNT_NO"),

            parts.getItem(1).alias("BRANCH_CODE"),

            parts.getItem(2).alias("PRODUCT"),

            parts.getItem(3).alias("SEGMENT"),

            parts.getItem(4).alias("AMOUNT"),

            parts.getItem(5).alias("GLCC"),

            parts.getItem(6).alias("ACCOUNT_NAME"),

            when(
                regexp_replace(
                    parts.getItem(7),
                    "^0+",
                    ""
                ) == "",
                "0"
            ).otherwise(
                regexp_replace(
                    parts.getItem(7),
                    "^0+",
                    ""
                )
            ).alias("STATUS")
        )

        total_row_count = parsed_df.count()

        print(
            f"Rows parsed from {file_name} : "
            f"{total_row_count}"
        )

        parsed_df.show(200, False)

        # ==================================================
        # GET FILE TYPE AND FILE DATE
        # ==================================================

        type_name = file_name.split("_")[0].upper()

        file_date = datetime.strptime(
            file_name.split("_")[2],
            "%d%m%Y"
        ).strftime("%d-%m-%Y")

        file_date_obj = datetime.strptime(
            file_date,
            "%d-%m-%Y"
        )

        print(f"File Type : {type_name}")
        print(f"File Date : {file_date}")

        # ==================================================
        # DATALAKE PATH
        # ==================================================

        year = file_date_obj.strftime("%Y")
        month = file_date_obj.strftime("%b").upper()
        day = file_date_obj.strftime("%d")

        output_path = (
            f"{HDFS_BASE}/druid-data-lake/"
            f"{year}/{month}/{day}/BANCS24/BGL"
        )

        summary_output_path = (
            f"{HDFS_BASE}/druid-data-lake/"
            f"{year}/{month}/{day}/PRODUCT_WISE/datalake"
        )

        create_path_if_not_exists(
            spark,
            output_path
        )

        create_path_if_not_exists(
            spark,
            summary_output_path
        )

        # ==================================================
        # CREATE SUMMARY DATAFRAME
        # ==================================================

        summary_df = (
            parsed_df

            .withColumn(
                "CGL",
                substring(
                    col("GLCC"),
                    9,
                    10
                )
            )

            .withColumn(
                "CURRENCY",
                substring(
                    col("GLCC"),
                    6,
                    3
                )
            )

            .withColumn(
                "TYPE",
                lit(type_name)
            )

            .withColumn(
                "DATE",
                lit(file_date)
            )

            .withColumn(
                "AMOUNT",
                col("AMOUNT")
                .cast("decimal(20,2)")
            )

            .groupBy(
                "CGL",
                "CURRENCY",
                "PRODUCT",
                "TYPE",
                "DATE"
            )

            .agg(
                sum("AMOUNT").alias("BALANCE")
            )

            .select(
                "CGL",
                "CURRENCY",
                "PRODUCT",
                "BALANCE",
                "TYPE",
                "DATE"
            )
        )

        summary_df.show(200, False)

        print(
            f"Summary dataframe created for "
            f"{file_name}"
        )

        # ==================================================
        # RERUN HANDLING
        # ==================================================

        if run_id > 1:

            print(
                f"Rerun detected (Run id: {run_id}). "
                f"Deleting existing {type_name} "
                f"for {file_date}"
            )

            delta_table = DeltaTable.forPath(
                spark,
                summary_output_path
            )

            delta_table.delete(
                f"TYPE = '{type_name}' "
                f"AND DATE = '{file_date}'"
            )

            print(
                "Existing summary records "
                "deleted successfully."
            )

        # ==================================================
        # WRITE SUMMARY TO DELTA
        # ==================================================

        # summary_df.write \
        #     .format("delta") \
        #     .mode("append") \
        #     .save(summary_output_path)

        print(
            f"Summary written successfully: "
            f"{type_name} - {file_date}"
        )

        # ==================================================
        # UPDATE TRACKER - PROCESSED
        # ==================================================

        tracker_df = spark.createDataFrame(
            [
                (
                    file_name,
                    file_date_obj.date(),
                    "PROCESSED",
                    total_row_count
                )
            ],
            [
                "FILE_NAME",
                "FILE_DATE",
                "STATUS",
                "ROW_COUNT"
            ]
        )

        tracker_df.show(20, False)

        write_oracle(
            tracker_df,
            "BGL_FILE_TRACKER"
        )

        print(
            f"Tracker updated successfully: "
            f"{file_name} -> PROCESSED"
        )

    except Exception as e:

        print("====================================================")
        print(
            f"Error processing path : {f}"
        )
        print(
            f"Exception             : {str(e)}"
        )
        print("====================================================")

        # ==================================================
        # UPDATE TRACKER - FAILED
        # ==================================================
        # Only update FAILED if we successfully obtained
        # an actual file name.
        # ==================================================

        try:

            if file_name is not None:

                failed_file_date = datetime.strptime(
                    file_name.split("_")[2],
                    "%d%m%Y"
                ).date()

                tracker_df = spark.createDataFrame(
                    [
                        (
                            file_name,
                            failed_file_date,
                            "FAILED",
                            0
                        )
                    ],
                    [
                        "FILE_NAME",
                        "FILE_DATE",
                        "STATUS",
                        "ROW_COUNT"
                    ]
                )

                write_oracle(
                    tracker_df,
                    "BGL_FILE_TRACKER"
                )

                print(
                    f"Tracker updated successfully: "
                    f"{file_name} -> FAILED"
                )

        except Exception as tracker_error:

            print(
                f"Could not update FAILED tracker "
                f"for {file_name}: "
                f"{tracker_error}"
            )

        # Continue with next found file
        continue


# ==========================================================
# UNFOUND PATHS
# ==========================================================
# No tracker update is done for unfound paths because
# there is no actual file name to store.
# ==========================================================

if len(unfound) > 0:

    print("====================================================")
    print(
        f"{len(unfound)} paths were not found."
    )
    print(
        "No tracker entries created for unfound paths."
    )
    print("====================================================")

    for f in unfound:
        print(f"Unfound path : {f}")


# ==========================================================
# PIPELINE COMPLETED
# ==========================================================

print("==========================================")
print("BGL Processing Completed Successfully")
print("==========================================")
