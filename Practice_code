        renderCell: (p) => (
          <Typography
            variant="body1"
            component="span"
            sx={{
              fontSize: "0.9rem",
            }}
          >
            {timeStampFormatter(p.value)}
          </Typography>
        ),
      },

      {
        field: "endTime",
        headerName: "Ended",
        flex: 1,
        minWidth: 200,
        headerAlign: "center",
        align: "center",
        sortable: false,
        filterable: false,
        disableColumnMenu: true,
        renderHeader: () => (
          <Box sx={{ display: "flex", alignItems: "center" }}>
            <CalendarMonthIcon sx={{ mr: 0.5 }} />
            <Typography variant="subtitle1">Ended</Typography>
          </Box>
        ),
        renderCell: (p) => (
          <Typography
            variant="body1"
            component="span"
            sx={{
              fontSize: "0.9rem",
            }}
          >
            {timeStampFormatter(p.value) || "-"}
          </Typography>
        ),
      },

      {
        field: "actions",
        headerName: "Actions",
        flex: 0.8,
        minWidth: 150,
        headerAlign: "center",
        align: "center",
        sortable: false,
        filterable: false,
        disableColumnMenu: true,
        renderHeader: () => (
          <Box sx={{ display: "flex", alignItems: "center" }}>
            <AppRegistrationIcon sx={{ mr: 0.5 }} />
            <Typography variant="subtitle1">Actions</Typography>
