    interbank_psv_df = (
        interbank_summary_df
        .orderBy(
            F.col("HEAD_CODE").asc()
        )
        .select(
            F.col("HEAD_CODE").alias(
                "NWSA_HEAD"
            ),
            F.col("HEAD_DESC").alias(
                "DESCRIPTION"
            ),
            F.format_string(
                "%.2f",
                F.col("total_balance")
            ).alias(
                "AMOUNT"
            )
        )
        .sort(
            col("HEAD_CODE")
        )
    )

    filename_interbank = (
        f"ACCR_INT_FILE_INTERBANK_{file_date}.psv"
    )

    write_csv_with_filename(
        df=interbank_psv_df,
        output_dir=output_path,
        filename=filename_interbank,
        header=True,
        sep="|"
    )

    log_etl(
        spark,
        process_run_id,
        "accrued_int",
        1,
        f"Interbank PSV file created successfully: "
        f"{filename_interbank}"
    )

    # ======================================================
    # INTERBANK TXT REPORT
    # ======================================================

    interbank_rows = (
        interbank_summary_df
        .orderBy(
            F.col("HEAD_CODE").asc()
        )
        .select(
            "HEAD_CODE",
            "HEAD_DESC",
            "total_balance"
        )
        .collect()
    )

    interbank_header_lines = [
        f"'{' ' * 48}STATE BANK OF INDIA\n",
        f"{' ' * 49}000  INDIAN RUPEE\n",
        f"  REPORT ON DAILY  ACCRUED INTEREST ON "
        f"INTERBANK DEPOSIT AS ON  {as_on_date}"
        f"{' ' * 8}RUN DATE : {run_date}\n\n",
