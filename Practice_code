{/* Selected filter summary after search */}
{searchPerformed && !filtersExpanded && (
  <Stack
    direction="row"
    spacing={1}
    useFlexGap
    flexWrap="wrap"
    sx={{
      mb: 1.5,
      alignItems: "center",
      width: "100%",
    }}
  >
    {filters.branches?.length > 0 && (
      <Chip
        size="small"
        label={`Branch: ${
          filters.branches.includes("All Branches")
            ? "All Branches"
            : filters.branches.join(", ")
        }`}
        variant="outlined"
      />
    )}

    {filters.circle && (
      <Chip
        size="small"
        label={`Circle: ${
          filters.circle === CIRCLE_GROUPS.ALL
            ? "All Circles"
            : filters.circle
        }`}
        variant="outlined"
      />
    )}

    {filters.cgl?.length > 0 && (
      <Chip
        size="small"
        label={`CGL: ${
          filters.cgl.includes("All CGLs")
            ? "All CGLs"
            : filters.cgl.join(", ")
        }`}
        variant="outlined"
      />
    )}

    {filters.currencies?.length > 0 && (
      <Chip
        size="small"
        label={`Currency: ${
          filters.currencies.includes("All Currencies")
            ? "All Currencies"
            : filters.currencies.join(", ")
        }`}
        variant="outlined"
      />
    )}

    {filters.balanceDate?.isValid?.() && (
      <Chip
        size="small"
        variant="outlined"
        label={`Balance Date: ${filters.balanceDate.format(
          "DD-MM-YYYY"
        )}`}
      />
    )}
  </Stack>
)}
