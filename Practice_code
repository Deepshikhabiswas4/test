  formatDuration,
  toPascalKebabCase,
} from "../../../utils/CommonUtilities";
import { getIconComponent } from "../../../utils/IconUtils";

/* ================= REUSABLE INFO ITEM ================= */
const InfoItem = ({ icon, label, value }) =>
  value ? (
    <Stack
      direction="row"
      spacing={1.5}
      alignItems="flex-start"
      sx={{
        p: 2,
        borderRadius: 2,
        bgcolor: "background.paper",
        boxShadow: 1,
        height: "100%",
      }}
    >
      <Box sx={{ mt: "2px", color: "text.secondary" }}>{icon}</Box>
      <Stack spacing={0.3}>
        <Typography variant="caption" color="text.secondary">
          {label}
        </Typography>
        <Typography fontWeight={500}>{value}</Typography>
      </Stack>
    </Stack>
  ) : null;

/* ================= MAIN COMPONENT ================= */
const StageDetails = ({ stage, isMobile }) => {
  if (!stage) return null;

  const remarks = stage.stageRemarks || "No Remarks";
  const charLimit = 100;
  const isLongRemarks = remarks.length > charLimit;

  const StageIcon = getIconComponent(stage?.stageIcon || "AccessTime");

  return (
    <Stack
      flex={2}
      p={isMobile ? 1 : 2}
      spacing={isMobile ? 2 : 3}
      sx={(theme) => ({
        // Simplify background and borders if rendering inline on mobile
        backgroundColor: isMobile ? "transparent" : theme.palette.action.hover,
        borderLeft: isMobile ? "none" : `1px solid ${theme.palette.divider}`,
        borderRadius: isMobile ? 2 : 0,
      })}
    >
      {/* ================= STAGE HEADER ================= */}
      <Stack direction="row" spacing={2} alignItems="center">
        <Box
          sx={{
            borderRadius: "50%",
            p: 1.5,
            bgcolor: "rgba(97, 134, 190, 0.12)",
            display: "flex",
          }}
        >
          <StageIcon
            sx={{
              height: isMobile ? 35 : 50,
              width: isMobile ? 35 : 50,
              transition: "transform 0.3s ease-in-out",
              "&:hover": {
                transform: "translateY(-5px)",
              },
            }}
          />
        </Box>

        <Stack>
          <Typography variant="subtitle2" color="text.secondary">
            Stage
          </Typography>
          <Typography variant={isMobile ? "subtitle1" : "h6"} fontWeight={600}>
            {stage.stageTitle || "Unknown"}
          </Typography>
        </Stack>
      </Stack>

      {/* Conditionally hide divider on mobile to keep inline view cleaner */}
      {!isMobile && <Divider />}

      {/* ================= ROW 2: START / END ================= */}
      <Grid container spacing={2}>
        <Grid size={{ xs: 12, md: 6 }}>
          <InfoItem
            icon={<PlayCircleOutlineIcon fontSize="small" />}
            label="Start Time"
            value={stage.startTime}
          />
        </Grid>
        <Grid size={{ xs: 12, md: 6 }}>
          <InfoItem
            icon={<StopCircleOutlinedIcon fontSize="small" />}
            label="End Time"
            value={stage.endTime}
          />
        </Grid>
      </Grid>

      {/* ================= ROW 3: TRIGGERED / DURATION ================= */}
      <Grid container spacing={2}>
        <Grid size={{ xs: 12, md: 6 }}>
          <InfoItem
            icon={<PersonOutlineIcon fontSize="small" />}
            label="Triggered By"
            value={toPascalKebabCase(stage.stageSource) || "N/A"}
          />
        </Grid>
        <Grid size={{ xs: 12, md: 6 }}>
          <InfoItem
            icon={<TimerOutlinedIcon fontSize="small" />}
            label="Time Taken"
            value={formatDuration(stage._START_TIME_RAW, stage._END_TIME_RAW)}
          />
        </Grid>
      </Grid>

      {/* ================= ROW 4: REMARKS ================= */}
      {isLongRemarks ? (
        <Stack>
          <Accordion
            elevation={0}
            sx={{
              p: 2.5,
              borderColor: "divider",
              borderRadius: 2,
              bgcolor: "background.paper",
              "&:before": { display: "none" },
              boxShadow: 1,
              mb: 1,
            }}
          >
            <AccordionSummary
              expandIcon={isLongRemarks ? <ExpandMoreIcon /> : null}
            >
              <Stack direction="row" spacing={1} alignItems="center">
                <NotesOutlinedIcon fontSize="small" color="action" />
                <Typography variant="subtitle2" color="text.secondary">
                  Remarks
                </Typography>
              </Stack>
            </AccordionSummary>

            <AccordionDetails>
              <Typography>{remarks}</Typography>
            </AccordionDetails>
          </Accordion>
        </Stack>
      ) : (
        <Stack
          spacing={1}
          sx={{
            p: 2.5,
            borderRadius: 2,
            bgcolor: "background.paper",
            boxShadow: 1,
          }}
        >
          <Stack direction="row" spacing={1} alignItems="center">
            <NotesOutlinedIcon fontSize="small" color="action" />
            <Typography variant="subtitle2" color="text.secondary">
              Remarks
            </Typography>
          </Stack>

          <Typography>{stage.stageRemarks || ""}</Typography>
        </Stack>
      )}
    </Stack>
  );
};

export default StageDetails;
import {
  Stepper,
  Step,
  StepLabel,
  StepContent,
  Typography,
  Box,
  Button,
} from "@mui/material";
import { getIconComponent } from "../../../utils/IconUtils";
import { StageStatus } from "../util/StageStatus";
import VisibilityOutlinedIcon from "@mui/icons-material/VisibilityOutlined";
import { useEffect, useRef } from "react";

/* ------------------ Step Label Content ------------------ */
const ProcessStepContent = ({
  stage,
  active,
  onClick,
  isDesktop,
  renderMobileDetails,
}) => {
  const notStarted =
    !stage.stageStatus || stage.stageStatus === StageStatus.NOT_STARTED;
  const started = stage.stageStatus === StageStatus.STARTED;
  const error = stage.stageStatus === StageStatus.ERROR;
  const completed = stage.stageStatus === StageStatus.COMPLETED;

  const statusText = notStarted
    ? "Not Started"
    : started
      ? "Started"
      : error
        ? "Failed"
        : "Completed";

  return (
    <>
      <StepLabel
        error={error}
        optional={
          <Typography
            variant="caption"
            color={error ? "error.main" : "text.secondary"}
          >
            {statusText}
          </Typography>
        }
        icon={
          <Box
            component={getIconComponent(stage.stageIcon)}
            sx={(theme) => ({
              color: error
                ? theme.palette.error.main
                : completed
                  ? theme.palette.success.main
                  : theme.palette.text.secondary,
            })}
          />
        }
      >
        <Typography variant="subtitle2">
          {stage.stageTitle || "Unknown"}
        </Typography>
      </StepLabel>

      <StepContent>
        {/* Default View Details button for inactive steps */}
        {!notStarted && !active && (
          <Button
            size="small"
            variant="contained"
            onClick={onClick}
            sx={{ mt: 1 }}
          >
            <VisibilityOutlinedIcon fontSize="small" sx={{ mr: 1 }} />
            View Details
          </Button>
        )}

        {/* Mobile View: Render StageDetails inline if active */}
        {!isDesktop && active && (
          <Box sx={{ mt: 2, mb: 1 }}>{renderMobileDetails(stage)}</Box>
        )}
      </StepContent>
    </>
  );
};

/* ------------------ Progress Stepper ------------------ */
const ProgressStepper = ({
  stageDetails = [],
  activeStep,
  onStageClick,
  isDesktop,
  renderMobileDetails,
}) => {
  const stepperRef = useRef(null);

  useEffect(() => {
    // Increased delay slightly to allow inline details to expand fully before scrolling
    const timer = setTimeout(() => {
      const activeElement = stepperRef.current?.querySelector(
        `[data-step="${activeStep}"]`,
      );
      if (activeElement) {
        activeElement.scrollIntoView({
          behavior: "smooth",
          block: "center",
        });
      }
    }, 300);

    return () => clearTimeout(timer);
  }, [activeStep]);

  return (
    <Box ref={stepperRef}>
      <Stepper orientation="vertical" nonLinear>
        {stageDetails.map((stage, index) => {
          const active = index === activeStep;

          return (
            <Step
              key={index}
              active
              data-step={index}
              sx={(theme) =>
                active && isDesktop
                  ? {
                      backgroundImage: `linear-gradient(to right, transparent, ${theme.palette.divider})`,
                      position: "relative",
                      "&::after": {
                        content: '""',
                        position: "absolute",
                        right: -8,
                        top: 0,
                        width: 8,
                        height: "100%",
                        backgroundColor: theme.palette.divider,
                      },
                    }
                  : {}
              }
            >
              <Box
                sx={(theme) =>
                  active && isDesktop
                    ? {
                        backgroundImage: `linear-gradient(to right, transparent, ${theme.palette.divider})`,
                        position: "relative",
                        "&::after": {
                          content: '""',
                          position: "absolute",
                          right: -8,
                          top: 0,
                          width: 8,
                          height: "100%",
                          backgroundColor: theme.palette.divider,
                        },
                      }
                    : {}
                }
              >
                <ProcessStepContent
                  stage={stage}
                  active={active}
                  onClick={() => onStageClick(index)}
                  isDesktop={isDesktop}
                  renderMobileDetails={renderMobileDetails}
                />
              </Box>
            </Step>
          );
        })}
      </Stepper>
    </Box>
  );
};

