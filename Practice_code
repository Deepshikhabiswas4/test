<Stack spacing={2} sx={{ mb: 2, width: "100%" }}>
  {/* Header row */}
  <Stack
    direction={{ xs: "column", lg: "row" }}
    justifyContent="space-between"
    alignItems={{ xs: "stretch", lg: "center" }}
    spacing={2}
  >
    <Box sx={{ flex: 1, minWidth: 0 }}>
      <Typography
        variant="h4"
        sx={{ fontWeight: 900 }}
      >
        Ledger Balance Insights
      </Typography>

      <Typography variant="body2" color="text.secondary">
        Ledger Balance search and analysis
      </Typography>
    </Box>

    {/* Keep your existing Switch Enquiry Type Paper here */}

    {searchPerformed && (
      <Button
        variant="contained"
        size="small"
        startIcon={<ManageSearchOutlinedIcon />}
        onClick={onToggleFilters}
        sx={{
          textTransform: "none",
          borderRadius: "8px",
          fontWeight: 600,
          minWidth: { xs: "100%", sm: "140px" },
          width: { xs: "100%", sm: "auto" },
          height: 36,
          px: 1.5,
        }}
      >
        {filtersExpanded ? "Hide Filters" : "Edit Filters"}
      </Button>
    )}
  </Stack>

  {/* Put the corrected selected-filter summary here */}
</Stack>
