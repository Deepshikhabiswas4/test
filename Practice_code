def main(spark, hdfs, etl_date, process_run_id):

    # ======================================================
    # PIPELINE START LOG
    # ======================================================

    log_etl(
        spark,
        process_run_id,
        "accrued_int",
        1,
        "Accrued interest pipeline started"
    )

    # ======================================================
    # DATE PREPARATION
    # ======================================================

    date_str = etl_date.strftime("%Y-%m-%d")
    date_var = etl_date.strftime("%d-%m-%Y")
