{/* Selected filter summary after search */}
{searchPerformed && !filtersExpanded && (
  <Stack
    direction="row"
    spacing={1}
    useFlexGap
    flexWrap="wrap"
    sx={{ mb: 1.5 }}
  >
    {filters.branches?.length > 0 && (
      <Chip
        size="small"
        label={`Branch: ${
          filters.branches.includes("ALL")
            ? "All Branches"
            : filters.branches.join(", ")
        }`}
        variant="outlined"
      />
    )}

    {filters.circle && (
      <Chip
        size="small"
        label={`Circle: ${filters.circle}`}
        variant="outlined"
      />
    )}

    {filters.cgl && (
      <Chip
        size="small"
        label={`CGL: ${filters.cgl}`}
        variant="outlined"
      />
    )}

    {filters.currencies?.length > 0 && (
      <Chip
        size="small"
        label={`Currency: ${
          filters.currencies.includes("ALL")
            ? "All Currencies"
            : filters.currencies.join(", ")
        }`}
        variant="outlined"
      />
    )}

    {filters.fromDate?.isValid?.() &&
      filters.toDate?.isValid?.() && (
        <Chip
          size="small"
          label={`Date: ${filters.fromDate.format(
            "DD-MM-YYYY"
          )} - ${filters.toDate.format("DD-MM-YYYY")}`}
          variant="outlined"
        />
      )}

    {filters.sourceFlags?.length > 0 && (
      <Chip
        size="small"
        label={`Transaction Type: ${
          filters.sourceFlags.length === sourceOptions.length
            ? "All Types"
            : filters.sourceFlags.map((item) => item.flagName).join(", ")
        }`}
        variant="outlined"
      />
    )}
  </Stack>
)}
