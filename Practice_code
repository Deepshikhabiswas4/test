  useTheme,
  useMediaQuery,
} from "@mui/material";

import GppBadIcon from "@mui/icons-material/GppBad";
import GppGoodIcon from "@mui/icons-material/GppGood";
import CloseIcon from "@mui/icons-material/Close";
import PictureAsPdfOutlinedIcon from "@mui/icons-material/PictureAsPdfOutlined";
import ImageOutlinedIcon from "@mui/icons-material/ImageOutlined";
import CheckCircleOutlineIcon from "@mui/icons-material/CheckCircleOutline";
import CloudDownloadTwoToneIcon from "@mui/icons-material/CloudDownloadTwoTone";
import ContentCopyIcon from "@mui/icons-material/ContentCopy";

import jsPDF from "jspdf";
import autoTable from "jspdf-autotable";
import { toPng } from "html-to-image";
import { useRef, useState, useEffect, useMemo } from "react";
import { TABLE_CONFIG } from "../util/ProcessSummaryTableConfig";
import DynamicSummaryTable from "./ProcessDynamicSummaryTable";
import ProcessReportDownloadProgress from "./ProcessReportDownloadProgress";
import { StageStatus } from "../util/StageStatus";

/* ================= FORMAT ================= */

const formatAmount = (num) =>
  typeof num === "number" ? num.toLocaleString("en-IN") : "—";

/* ================= SUMMARY → FILE MAP ================= */

const SUMMARY_FILE_MAP = {
  BALANCE: "balance_compare_report",
  CIBA: "intr_report",
  SUSPENSE: "cntr_report",
};

/* ====================================================== */

const ProcessSummaryDialog = ({
  open,
  data,
  isCurrentDate,
  onClose,
  onAccept,
  onReject,
  onDownload,
  downloadProgress,
  permissions = {},
}) => {
  const theme = useTheme();
  // md breakpoint usually covers iPads in portrait and mobile devices
  const isDesktop = useMediaQuery(theme.breakpoints.up("md"));

  const reportRef = useRef(null);
  const copyTimeoutRef = useRef(null);

  const [copied, setCopied] = useState(false);
  const [summaryType, setSummaryType] = useState("BALANCE");

  const safeData = data || {};
  /* ================= DATA ================= */

  const {
    process = {},
    processRunId,
    RECON_RUN_DATE,
    differenceSummary = [],
    cibaSummary = [],
    suspenseSummary = [],
    stages = [],
  } = safeData;

  /* ================= STAGE CHECK ================= */

  const balanceDone = stages.some(
    (s) => s.stageId === "balance_Compare_generated" && s.stageStatus === 2,
  );

  const cibaDone = stages.some(
    (s) => s.stageId === "intr_summary_calculated" && s.stageStatus === 2,
  );

  const suspenseDone = stages.some(
    (s) => s.stageId === "cntr_summary_calculated" && s.stageStatus === 2,
  );

  const stageWaiting = process?.status == StageStatus.WAITING_FOR_APPROVAL;

  /* ================= AVAILABLE TYPES ================= */

  const availableSummaryTypes = useMemo(() => {
    const arr = [];

    if (balanceDone) arr.push("BALANCE");
    if (cibaDone) arr.push("CIBA");
    if (suspenseDone) arr.push("SUSPENSE");

    return arr;
  }, [balanceDone, cibaDone, suspenseDone]);

  /* ================= AUTO FIX SELECTED TYPE ================= */

  useEffect(() => {
    if (!availableSummaryTypes.includes(summaryType)) {
      setSummaryType(availableSummaryTypes[0] || "BALANCE");
    }
  }, [availableSummaryTypes, summaryType]);

  /* ================= ACTIVE SUMMARY ================= */

  const activeSummary = useMemo(() => {
    switch (summaryType) {
      case "BALANCE":
        return differenceSummary || [];

      case "CIBA":
        return cibaSummary || [];

      case "SUSPENSE":
        return suspenseSummary || [];

      default:
        return [];
    }
  }, [summaryType, differenceSummary, cibaSummary, suspenseSummary]);

  /* ================= EXPORT PDF ================= */

  const exportPDF = () => {
    const config = TABLE_CONFIG[summaryType];

    if (!config) return;

    const doc = new jsPDF("p", "pt");

    doc.setFontSize(14);
    doc.text(`${summaryType} Summary Report`, 40, 40);

    doc.setFontSize(10);
    doc.text(`Reconciliation Date: ${RECON_RUN_DATE}`, 40, 58);

    /* ================= HEADERS ================= */

    const headers = config.columns.map((col) => col.label);

    /* ================= BODY ================= */

    const body = activeSummary.map((row) =>
      config.columns.map((col) =>
        col.align === "right"
          ? formatAmount(row[col.field]) || row[col.field]
          : row[col.field] || "—",
      ),
    );

    /* ================= TOTAL ROW ================= */

    if (config.totalFields?.length) {
      const totals = {};

      config.totalFields.forEach((field) => {
        totals[field] = activeSummary.reduce(
          (sum, r) => sum + (Number(r[field]) || 0),
          0,
        );
      });

      const totalRow = config.columns.map((col, index) => {
        if (index === 0) return "TOTAL";

        if (totals[col.field] !== undefined)
          return formatAmount(totals[col.field]);

        return "";
      });

      body.push(totalRow);
    }

    /* ================= GENERATE TABLE ================= */

    autoTable(doc, {
      startY: 80,
      head: [headers],
      body,
      styles: {
        fontSize: 9,
        halign: "right",
      },
      columnStyles: {
        0: { halign: "left" },
      },
      didParseCell: (data) => {
        if (data.row.index === body.length - 1) {
          data.cell.styles.fontStyle = "bold";
        }
      },
    });

    doc.save(`${summaryType}_Summary_${RECON_RUN_DATE}.pdf`);
  };

  const copyToClipboard = async () => {
    const config = TABLE_CONFIG[summaryType];

    if (!config) return;

    /* ================= HEADERS ================= */
    const headers = config.columns.map((col) => col.label);

    /* ================= BODY ================= */
    const body = activeSummary.map((row) =>
      config.columns.map((col) =>
        col.align === "right"
          ? formatAmount(row[col.field]) || row[col.field]
          : row[col.field] || "",
      ),
    );

    /* ================= TOTAL ROW ================= */
    if (config.totalFields?.length) {
      const totals = {};

      config.totalFields.forEach((field) => {
        totals[field] = activeSummary.reduce(
          (sum, r) => sum + (Number(r[field]) || 0),
          0,
        );
      });

      const totalRow = config.columns.map((col, index) => {
        if (index === 0) return "TOTAL";
        if (totals[col.field] !== undefined)
          return formatAmount(totals[col.field]);
        return "";
      });

      body.push(totalRow);
    }

    /* ================= BUILD TSV ================= */
    const tsv = [headers, ...body].map((row) => row.join("\t")).join("\n");

    /* ================= COPY ================= */
    try {
      await navigator.clipboard.writeText(tsv);
    } catch {
      // Fallback for older browsers / non-secure contexts
      const ta = document.createElement("textarea");
      ta.value = tsv;
      ta.style.cssText = "position:fixed;top:0;left:0;opacity:0";
      document.body.appendChild(ta);
      ta.select();
      document.execCommand("copy");
      document.body.removeChild(ta);
    }
  };

  /* ================= COPY PNG ================= */
  const copyPNGToClipboard = async () => {
    if (!reportRef.current) return;

    const element = reportRef.current;

    try {
      const dataUrl = await toPng(element, {
        cacheBust: true,
        backgroundColor: "#ffffff",
        pixelRatio: 2,

        /* fixes font/css errors */
        skipFonts: true,
      });

      const blob = await (await fetch(dataUrl)).blob();

      await navigator.clipboard.write([
        new ClipboardItem({
          "image/png": blob,
        }),
      ]);

      setCopied(true);

      clearTimeout(copyTimeoutRef.current);

      copyTimeoutRef.current = setTimeout(() => {
        setCopied(false);
      }, 2000);
    } catch (err) {
      console.error(err);
    }
  };

  /* ====================================================== */

  return (
    <>
      <Dialog
        open={open}
        fullWidth
        maxWidth="md"
        sx={{
          "& .MuiDialog-paper": {
            height: "78vh",
            maxHeight: "78vh",
            display: "flex",
            flexDirection: "column",
          },
        }}
      >
        {/* HEADER */}

        <Box
          sx={{
            px: isDesktop ? 3 : 2,
            py: 2,
            borderBottom: 1,
            borderColor: "divider",
            display: "flex",
            justifyContent: "space-between",
            alignItems: isDesktop ? "center" : "flex-start",
            flexDirection: isDesktop ? "row" : "column", // Stack on mobile
            gap: isDesktop ? 0 : 2,
            position: "relative",
            flexShrink: 0,
          }}
        >
          <Box pr={isDesktop ? 0 : 5}>
            <Typography
              variant={isDesktop ? "h6" : "subtitle1"}
              fontWeight={700}
            >
              {summaryType} Summary Report
            </Typography>
            <Typography variant="body2" color="text.secondary">
              Reconciliation Date: {RECON_RUN_DATE}
            </Typography>
          </Box>

          <Stack
            direction="row"
            spacing={1}
            sx={{ alignSelf: isDesktop ? "auto" : "flex-end" }}
          >
            <Tooltip title="Copy To Clipboard">
              <IconButton onClick={copyToClipboard}>
                <ContentCopyIcon />
              </IconButton>
            </Tooltip>

            <Tooltip title="Export summary to PDF">
              <IconButton onClick={exportPDF}>
                <PictureAsPdfOutlinedIcon />
              </IconButton>
            </Tooltip>

            <Tooltip title={copied ? "Copied!" : "Copy summary as image"}>
              <IconButton
                onClick={copyPNGToClipboard}
                sx={{ color: copied ? "success.main" : "inherit" }}
              >
                {copied ? <CheckCircleOutlineIcon /> : <ImageOutlinedIcon />}
              </IconButton>
            </Tooltip>

            {/* If Mobile, absolutely position close button to top right */}
            <IconButton
              onClick={onClose}
              sx={{
                ...(!isDesktop && { position: "absolute", top: 8, right: 8 }),
              }}
            >
              <CloseIcon />
            </IconButton>
          </Stack>
        </Box>

        {/* BODY */}

        <DialogContent
          sx={{
            p: isDesktop ? 3 : 2,
            flex: 1, // ← fill remaining height
            overflow: "auto", // ← scroll if content overflows
            display: "flex",
            flexDirection: "column",
          }}
        >
          {/* RADIO */}
          {permissions.download && availableSummaryTypes.length > 0 && (
            <Paper sx={{ p: 2, mb: 2, flexShrink: 0 }}>
              <Stack
                direction={isDesktop ? "row" : "column"} // Stack inputs on mobile
                justifyContent="space-between"
                alignItems={isDesktop ? "center" : "stretch"}
                flexWrap="wrap"
                gap={2}
              >
                <RadioGroup
                  row={isDesktop} // Only display in row for desktop
                  value={summaryType}
                  onChange={(e) => {
                    setSummaryType(e.target.value);
                  }}
                >
                  {availableSummaryTypes.includes("BALANCE") && (
                    <FormControlLabel
                      value="BALANCE"
                      control={<Radio />}
                      label="Balance Compare"
                      disabled={downloadProgress?.inProgress}
                    />
                  )}

                  {availableSummaryTypes.includes("CIBA") && (
                    <FormControlLabel
                      value="CIBA"
                      control={<Radio />}
                      label="CIBA"
                      disabled={downloadProgress?.inProgress}
                    />
                  )}

                  {availableSummaryTypes.includes("SUSPENSE") && (
                    <FormControlLabel
                      value="SUSPENSE"
                      control={<Radio />}
                      label="Suspense"
                      disabled={downloadProgress?.inProgress}
                    />
                  )}
                </RadioGroup>

                <Button
                  startIcon={<CloudDownloadTwoToneIcon />}
                  variant="contained"
                  fullWidth={!isDesktop} // Full width on mobile
                  onClick={() =>
                    onDownload(
                      SUMMARY_FILE_MAP[summaryType],
                      RECON_RUN_DATE,
                      processRunId,
                    )
                  }
                  disabled={downloadProgress?.inProgress}
                >
                  Download Full Report
                </Button>
              </Stack>

              {/* DOWNLOAD PROGRESS */}

              <ProcessReportDownloadProgress
                downloadProgress={downloadProgress}
              />
            </Paper>
          )}

          {/* TABLE */}

          <Box ref={reportRef}>
            <DynamicSummaryTable
              summaryType={summaryType}
              data={activeSummary}
            />
          </Box>
        </DialogContent>

        {/* FOOTER */}

        {isCurrentDate && safeData && stageWaiting && (
          <Box
            sx={{
              px: isDesktop ? 3 : 2,
              py: 2,
              borderTop: 1,
              borderColor: "divider",
              display: "flex",
              flexDirection: isDesktop ? "row" : "column", // Stack buttons vertically on mobile
              justifyContent: "center",
              gap: 2,
              flexShrink: 0,
            }}
          >
            {permissions.reject && (
              <Button
                color="error"
                variant="outlined"
                startIcon={<GppBadIcon />}
                onClick={onReject}
                fullWidth={!isDesktop}
              >
                Reject
              </Button>
            )}

            {permissions.approve && (
              <Button
                color="success"
                variant="contained"
                startIcon={<GppGoodIcon />}
                onClick={onAccept}
                fullWidth={!isDesktop}
              >
                Accept
              </Button>
            )}
          </Box>
        )}
      </Dialog>
    </>
  );
};

