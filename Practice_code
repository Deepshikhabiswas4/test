    interbank_body_lines = [
        f"{str(r['HEAD_CODE'] or ''):<21}"
        f"{str(r['HEAD_DESC'] or ''):<55}"
        f"{float(r['total_balance'] or 0.0):>24.2f}\n"
        for r in interbank_rows
