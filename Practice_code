          sx={{ position: "absolute", right: 12, top: 12 }}
        >
          <CloseIcon />
        </IconButton>
      </DialogTitle>

      {/* ---------- BODY ---------- */}
      <DialogContent
        dividers
        sx={{
          p: 0,
          display: isDesktop ? "grid" : "block",
          gridTemplateColumns: isDesktop ? "280px 1fr" : "none",
          height: "100%",
        }}
      >
        {/* LEFT / MAIN – SCROLLABLE STEPPER */}
        <Box
          sx={{
            borderRight: isDesktop ? "1px solid" : "none",
            borderColor: "divider",
            overflowY: "auto",
            px: 2,
            py: isDesktop ? 1 : 3,
            height: "100%",
          }}
        >
          <ProgressStepper
            stageDetails={stages}
            activeStep={activeStep}
            onStageClick={setActiveStep}
            isDesktop={isDesktop}
            // Pass a render prop to avoid circular dependencies
            renderMobileDetails={(stage) => (
              <StageDetails stage={stage} isMobile={!isDesktop} />
            )}
          />
        </Box>

        {/* RIGHT – FIXED CONTENT (Desktop Only) */}
        {isDesktop && (
          <Box sx={{ p: 3, overflowY: "auto" }}>
            <StageDetails stage={stages[activeStep]} isMobile={false} />
          </Box>
        )}
      </DialogContent>

      {/* ---------- FOOTER ---------- */}
      {isCurrentDate && (permissions.start || permissions.stop) && (
        <DialogActions sx={{ p: isDesktop ? 1 : 2 }}>
          {permissions.start &&
            lastStatus !== StageStatus.STARTED &&
            !nonActionableProcess && (
              <Button
                startIcon={<RestartAltIcon />}
                onClick={() => onStart(process)}
                fullWidth={!isDesktop}
              >
                Restart
              </Button>
            )}

          {permissions.stop &&
            lastStatus === StageStatus.STARTED &&
            !(
              nonActionableProcess ||
              (process.processId == 3 &&
                process.status == StageStatus.WAITING_FOR_APPROVAL)
            ) && (
              <Button
                color="error"
                startIcon={<StopIcon />}
                onClick={() => onStop(process)}
                fullWidth={!isDesktop}
              >
                Stop
              </Button>
            )}

          {!(
            (permissions.start &&
              lastStatus !== StageStatus.STARTED &&
              !nonActionableProcess) ||
            (permissions.stop &&
              lastStatus === StageStatus.STARTED &&
              !(
                nonActionableProcess ||
                (process.processId == 3 &&
                  process.status == StageStatus.WAITING_FOR_APPROVAL)
              ))
          ) && (
            <Button fullWidth={!isDesktop} onClick={onClose}>
              Close
            </Button>
          )}
        </DialogActions>
      )}
    </Dialog>
  );
};

