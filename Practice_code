            "total_balance",
            F.when(
                F.col("FLAG") == "Y",
                F.col("file_balance")
                - F.col("memo_balance")
            ).otherwise(
                F.col("file_balance")
            )
        )
        .filter(
            F.col("total_balance") != 0
