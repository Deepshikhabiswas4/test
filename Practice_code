        ),

        renderCell: (params) => {
          const row = params.row.raw;
          const isLatest = params.row.isLatestRun;

          const showRestart = isLatest && row.status !== StageStatus.STARTED;

          const showStop = isLatest && row.status === StageStatus.STARTED;

          const nonActionableProcess =
            row.processId == 7 || row.processId == 12;

          return (
            <Stack
              direction="row"
              spacing={0.5}
              alignItems="center"
              justifyContent="center"
              sx={{ height: "100%", width: "100%" }}
            >
              {(permissions.restart || permissions.start) &&
                isCurrentDate &&
                showRestart &&
                !nonActionableProcess && (
                  <Tooltip title="Restart">
                    <IconButton
                      size="small"
                      onClick={() => actions.onStart(row)}
                    >
                      <RestartAltIcon />
                    </IconButton>
                  </Tooltip>
                )}

              {permissions.stop &&
                isCurrentDate &&
                showStop &&
                !nonActionableProcess && (
                  <Tooltip title="Stop">
                    <IconButton
                      size="small"
                      onClick={() => actions.onStop(row)}
                      sx={{ p: { xs: 0.5, md: 1 } }}
                    >
                      <StopIcon />
                    </IconButton>
                  </Tooltip>
                )}

              {permissions.view && (
                <Tooltip title="View">
                  <IconButton
                    size="small"
                    onClick={() => actions.onView(row)}
                    sx={{ p: { xs: 0.5, md: 1 } }}
                  >
                    <VisibilityIcon />
                  </IconButton>
                </Tooltip>
              )}

              {permissions.view && params.row.hasSummary && (
                <Tooltip title="Summary">
                  <IconButton
                    size="small"
                    onClick={() => actions.onSummary(row)}
                    sx={{ p: { xs: 0.5, md: 1 } }}
                  >
                    <SummarizeOutlinedIcon />
                  </IconButton>
                </Tooltip>
              )}
            </Stack>
          );
        },
      },
    ],
    [
      actions,
      isCurrentDate,
      permissions.restart,
      permissions.start,
      permissions.stop,
      permissions.view,
      statusOptions,
    ],
  );

  const filteredColumns = useMemo(() => {
    if (
      permissions.start ||
      permissions.stop ||
      permissions.restart ||
      permissions.view
    ) {
      return columns;
    }
    return columns.filter((c) => c.field !== "actions");
  }, [columns, permissions]);

  // Reset to page 0 whenever loading changes
  useEffect(() => {
    if (loading) {
      setPaginationModel((prev) => ({
        ...prev,
        page: 0,
      }));
    }
  }, [processes, loading]);

  /* =====================================================
     FINAL RENDER
  ===================================================== */

  return (
    <Box>
      {/* Unified Card Container */}
      <Card
        sx={{
          width: "100%",
          boxShadow: 3,
          bgcolor: "background.paper",
          overflow: "hidden",
          displya: "flex",
          flexDirection: "column",
        }}
      >
        <DataGrid
          rows={rows}
          columns={filteredColumns}
          loading={loading}
          disableRowSelectionOnClick
          pageSizeOptions={[10, 25, 50]}
          paginationModel={paginationModel}
          onPaginationModelChange={setPaginationModel}
          initialState={{
            pagination: { paginationModel: { pageSize: 10, page: 0 } },
            sorting: { sortModel: [{ field: "startTime", sort: "desc" }] },
          }}
          getRowId={(p) => p.id}
          sx={{
            border: "none", // Removes outline to blend into card
            "& .MuiDataGrid-columnHeaders": {
              borderTop: "none",
            },
          }}
          slots={{
            noRowsOverlay: () => (
              <Stack
                height="100%"
                alignItems="center"
                justifyContent="center"
                spacing={1}
              >
                <InfoIcon
                  sx={{
                    fontSize: 48,
                    color: "text.secondary",
                  }}
                />

                <Typography variant="h6">No processes available</Typography>

                <Typography variant="body2">
                  Processes not found for the ETL date.
                </Typography>
              </Stack>
